# ============================================================
# APIキー設定テンプレート
# ------------------------------------------------------------
# 使い方:
#   1. このファイルを .env という名前で複製する
#        cp .env.example .env
#   2. 複製した .env に実際のキーを記入する
#   3. .env は .gitignore 済み。絶対にコミット・共有・外部送信しない
#
# 注意:
#   - このファイル（.env.example）にはキーの実体を書かないこと
#   - 変数名だけを記し、値は必ず空のままコミットする
# ============================================================

# Google Gemini API（AI社員ペルソナ画像の生成等で使用）
GEMINI_API_KEY=

# Anthropic API（Claude を API 経由で直接呼ぶ場合のみ。
# 定額プランの Claude Code を使う通常運用では不要）
ANTHROPIC_API_KEY=
