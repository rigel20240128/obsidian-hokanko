#HMS Anybus-CC Module file    (HMS-ABS-CCL(Occupies 4 Stations))

[File]
  FileComment = Anybus-CC Module;
  CreateDate = 2007/06/26;
  CreateTime = 12:00:00;
  ModDate = 2007/06/26;
  ModTime = 12:00:00;
  Version = 1.0;

[Device]
  VendName = HMS Industrial Networks;     #Vendor Name
  VendID = 0x0212;                        #Vendor Code
  StationType = 1;                        #Station Type (0:I/O 1:Remote Device 2:Intelligent Device)
  RemDevType = 0x4E;                      #Remote Device Type (Anybus)
  DevModel = HMS-ABCC-CCL;                #Model
  DevVer = A;                             #Version Information
  Senyuu = 4;                             #Number Of Occupied Stations
  BmpFile = hms_anybus.bmp;               #Corresponds Bitmap File Name
  ErrReg = RWrF;                          #For Error Indication
  UpDownLoadF = 0;                        #Not Correspond To Load
  MasterFlg = 0;                          #Impossible To Set In The Standby Master

# Name,Bit Register No.,Turn Off Name,Turn On Name
[IO_Info_RX]
EntryNum = 4;
  BEntry1 = Initial data processing request flag,  RX78, ,        Initial data processing request;
  BEntry2 = Initial data setting complete flag,    RX79, ,        Initial data setting complete;
  BEntry3 = Error status flag,                     RX7A, No error,Error;
  BEntry4 = Remote READY,                          RX7B, ,        Ready;

[IO_Info_RY]
EntryNum = 3;
  BEntry1 = Initial data processing complete flag, RY78,    ,        Initial data processing complete;
  BEntry2 = Initial data setting request flag,     RY79,    ,        Initial data setting;
  BEntry3 = Error reset request flag,              RY7A,    ,        Error reset;

[IO_Info_RWw]
Comment = HMS Anybus-CC Module(Occupies 4 stations);      #Comments
EntryNum = 16;             #Number of Entries
