#HMS Anybus-CC Module file    (HMS-ABCC-CCL(Occupies 3 Stations))

[File]
  FileComment = Anybus-CC Module;
  CreateDate = 2007/06/26;
  CreateTime = 12:00:00;
  ModDate = 2007/06/26;
  ModTime = 12:00:00;
  Version = 1.0;

[Device]
  VendName = HMS Industrial Networks;     #Vendor Name
  VendID = 0x0212;                        #Vendor Code
  StationType = 1;                        #Station Type (0:I/O 1:Remote Device 2:Intelligent Device)
  RemDevType = 0x4E;                      #Remote Device Type (Anybus)
  DevModel = HMS-ABCC-CCL;                #Model
  DevVer = A;                             #Version Information
  Senyuu = 3;                             #Number Of Occupied Stations
  BmpFile = hms_anybus.bmp;               #Corresponds Bitmap File Name
  ErrReg = RWrB;                          #For Error Indication
  UpDownLoadF = 0;                        #Not Correspond To Load
  MasterFlg = 0;                          #Impossible To Set In The Standby Master

# Name,Bit Register No.,Turn Off Name,Turn On Name
[IO_Info_RX]
EntryNum = 4;
  BEntry1 = Initial data processing request flag,  RX58, ,        Initial data processing request;
  BEntry2 = Initial data setting complete flag,    RX59, ,        Initial data setting complete;
  BEntry3 = Error status flag,                     RX5A, No error,Error;
  BEntry4 = Remote READY,                          RX5B, ,        Ready;

[IO_Info_RY]
EntryNum = 3;
  BEntry1 = Initial data processing complete flag, RY58,    ,        Initial data processing complete;
  BEntry2 = Initial data setting request flag,     RY59,    ,        Initial data setting;
  BEntry3 = Error reset request flag,              RY5A,    ,        Error reset;

