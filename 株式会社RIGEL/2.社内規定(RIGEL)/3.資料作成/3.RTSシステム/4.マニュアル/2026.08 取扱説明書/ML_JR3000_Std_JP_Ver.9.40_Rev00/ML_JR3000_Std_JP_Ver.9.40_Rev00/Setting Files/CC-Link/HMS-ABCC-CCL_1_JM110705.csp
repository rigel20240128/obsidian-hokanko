#HMS Anybus-CC Module file     (HMS-ABCC-CCL(Occupies 1 Station))

[File]
  FileComment = Anybus-CC Module;
  CreateDate = 2007/06/26;
  CreateTime = 12:00:00;
  ModDate = 2007/06/26;
  ModTime = 12:00:00;
  Version = 1.0;

[Device]
  VendName = HMS Industrial Networks;     #Vendor Name
  VendID = 0x0212;                        #Vendor Code
  StationType = 1;                        #Station Type (0:I/O 1:Remote Device 2:Intelligent Device)
  RemDevType = 0x4E;                      #Remote Device Type (Anybus)
  DevModel = HMS-ABCC-CCL;                #Model
  DevVer = A;                             #Version Information
  Senyuu = 1;                             #Number Of Occupied Stations
  BmpFile = hms_anybus.bmp;               #Corresponds Bitmap File Name
  ErrReg = RWr3;                          #For Error Indication
  UpDownLoadF = 0;                        #Not Correspond To Load
  MasterFlg = 0;                          #Impossible To Set In The Standby Master

# Name,Bit Register No.,Turn Off Name,Turn On Name
[IO_Info_RX]
EntryNum = 4;
  BEntry1 = Initial data processing request flag,  RX18, ,        Initial data processing request;
  BEntry2 = Initial data setting complete flag,    RX19, ,        Initial data setting complete;
  BEntry3 = Error status flag,                     RX1A,          No error,Error;
  BEntry4 = Remote READY,                          RX1B, ,        Ready;

[IO_Info_RY]
EntryNum = 3;
  BEntry1 = Initial data processing complete flag, RY18,    ,        Initial data processing complete;
  BEntry2 = Initial data setting request flag,     RY19,    ,        Initial data setting;
  BEntry3 = Error reset request flag,              RY1A,    ,        Error reset;

[IO_Info_RWw]
Comment = HMS Anybus-CC Module(Occupies 1 station);       #Comments
EntryNum = 4;              #Number of Entries
#
#  [<Signal(Parameter) Name>   <RW number><Data Type><Section Name><Initial Value><Range><Unit><Handshake RY><Handshake RX><RWr><Interlock><RY of midterm><RX of midterm>
#
  WEntry1 = User write area word 0,       RWw0, 0, ,  0, ,  , -, -,,,,;
  WEntry2 = User write area word 1,       RWw1, 0, ,  0, ,  , -, -,,,,;
  WEntry3 = User write area word 2,       RWw2, 0, ,  0, ,  , -, -,,,,;
  WEntry4 = User write area word 3,       RWw3, 0, ,  0, ,  , -, -,,,,;

[IO_Info_RWr]
Comment = HMS Anybus-CC Module(Occupies 1 station);       #Comments
EntryNum = 5;              #Number of Entries
#
#  [<Signal(Parameter) Name>   <RW number><Data Type><Section Name><Initial Value><Range><Unit><Handshake RY><Handshake RX><RWr><Interlock><RY of midterm><RX of midterm>
#
  WEntry1 = User read area word 0,        RWr0, 0, ,  0, ,  , -, -,,,,;
  WEntry2 = User read area word 1,        RWr1, 0, ,  0, ,  , -, -,,,,;
  WEntry3 = User read area word 2,        RWr2, 0, ,  0, ,  , -, -,,,,;
  WEntry4 = Error Code Severity,          RWr3, 4, ,  0, ,  , -, -,,,,;
  WEntry5 = Error Code Event,             RWr3, 5, ,  0, ,  , -, -,,,,;
