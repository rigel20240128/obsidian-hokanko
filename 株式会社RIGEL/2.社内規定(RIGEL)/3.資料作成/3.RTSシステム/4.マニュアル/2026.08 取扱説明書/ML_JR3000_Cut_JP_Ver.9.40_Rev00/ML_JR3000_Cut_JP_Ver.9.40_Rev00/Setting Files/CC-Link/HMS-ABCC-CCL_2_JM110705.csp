#HMS Anybus-CC Module file    (HMS-ABCC-CCL(Occupies 2 Stations))

[File]
  FileComment = Anybus-CC Module;
  CreateDate = 2007/06/26;
  CreateTime = 12:00:00;
  ModDate = 2007/06/26;
  ModTime = 12:00:00;
  Version = 1.0;

[Device]
  VendName = HMS Industrial Networks;     #Vendor Name
  VendID = 0x0212;                        #Vendor Code
  StationType = 1;                        #Station Type (0:I/O 1:Remote Device 2:Intelligent Device)
  RemDevType = 0x4E;                      #Remote Device Type (Anybus)
  DevModel = HMS-ABCC-CCL;                #Model
  DevVer = A;                             #Version Information
  Senyuu = 2;                             #Number Of Occupied Stations
  BmpFile = hms_anybus.bmp;               #Corresponds Bitmap File Name
  ErrReg = RWr7;                          #For Error Indication
  UpDownLoadF = 0;                        #Not Correspond To Load
  MasterFlg = 0;                          #Impossible To Set In The Standby Master

# Name,Bit Register No.,Turn Off Name,Turn On Name
[IO_Info_RX]
EntryNum = 4;
  BEntry1 = Initial data processing request flag,  RX38, ,        Initial data processing request;
  BEntry2 = Initial data setting complete flag,    RX39, ,        Initial data setting complete;
  BEntry3 = Error status flag,                     RX3A, No error,Error;
  BEntry4 = Remote READY,                          RX3B, ,        Ready;

[IO_Info_RY]
EntryNum = 3;
  BEntry1 = Initial data processing complete flag, RY38,    ,        Initial data processing complete;
  BEntry2 = Initial data setting request flag,     RY39,    ,        Initial data setting;
  BEntry3 = Error reset request flag,              RY3A,    ,        Error reset;

[IO_Info_RWw]
Comment = HMS Anybus-CC Module(Occupies 2 stations);     #Comments
